# Environment files. `.env` is COMMITTED on purpose and may hold PUBLIC build-time
# config only (e.g. VITE_PUBLIC_APP_ORIGIN) — the hosted build (Lovable) reads it from
# the repo. Keys and secrets go in .env.local / .env.*.local, which stay ignored.
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/

# Dev agent reports — generated output, not source
reports/dev-agent/

# Supabase CLI local runtime state
supabase/.temp/

# Sprint 2K local dry-run reports (not committed)
/artifacts/
