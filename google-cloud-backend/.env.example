# ─────────────────────────────────────────────────────────────────────────────
# MallMind Cloud Run Backend — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# In production, inject these via Cloud Run environment variables
# or Secret Manager references.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (existing operational database) ─────────────────────────────────
# Use the service role key — this backend runs server-side only.
# Never expose this key to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Option A: Gemini API key (simplest for dev/testing)
GEMINI_API_KEY=your-gemini-api-key-here

# Option B: Vertex AI (production — uses Application Default Credentials)
# Set VERTEX_PROJECT_ID and leave GEMINI_API_KEY blank to use Vertex AI.
VERTEX_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── Google Cloud project ──────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ── Server ────────────────────────────────────────────────────────────────────
# Cloud Run injects PORT=8080 automatically. Override for local dev if needed.
PORT=8080

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Authoritative, EXACT-MATCH allowlist of browser origins, comma-separated.
# This governs every environment (there is no wildcard/dev fork). List the exact
# origins that may call this backend from a browser:
#   - the production frontend domain (e.g. https://mallmind.app)
#   - any approved preview origin (e.g. a specific Cloud Shell web-preview URL)
#   - localhost dev origins (Vite defaults to 8080; the preview harness uses 8087)
# Exact match only — no wildcard subdomains (no *.cloudshell.dev / *.vercel.app).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:8087
# Legacy single-origin variable. Still honoured and MERGED into the allowlist for
# back-compat, so an already-deployed backend keeps working. Prefer CORS_ORIGINS.
# ALLOWED_ORIGIN=https://mallmind.app
# Requests with NO Origin header (server-to-server, health checks, curl, the CLI)
# are allowed by default — browsers always send Origin, so this does not widen
# browser access. Set to "false" to reject no-Origin requests.
# CORS_ALLOW_NO_ORIGIN=true

# ── IMPORTANT: what belongs here vs what doesn't ──────────────────────────────
# ✅  SUPABASE_SERVICE_ROLE_KEY — server-side only, stored in Secret Manager in production
# ✅  GEMINI_API_KEY / Anthropic key — server-side only
# ❌  VITE_* variables — those belong in the frontend .env.local only
# ❌  Service role key in frontend env — NEVER do this
# See docs/SECURITY_ENVIRONMENT_CHECKLIST.md for full guidance.
